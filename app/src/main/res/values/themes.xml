<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: light here, dark in values-night; bars are edge to edge. -->
    <style name="Theme.StackBoxes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Launch screen: the Arcade blocks stack up on the icon's background, then the game. -->
    <style name="Theme.StackBoxes.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_arcade_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_arcade</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.StackBoxes</item>
    </style>

    <!-- Reduce motion: the same launch screen with the icon standing still (Android 13+). -->
    <style name="Theme.StackBoxes.Starting.Still">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_arcade_still</item>
    </style>
</resources>
