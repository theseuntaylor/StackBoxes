<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher_arcade"
            android:roundIcon="@mipmap/ic_launcher_arcade"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:theme="@style/Theme.StackBoxes"
            tools:targetApi="31">
        <activity
                android:name=".MainActivity"
                android:exported="true"
                android:label="@string/app_name"
                android:theme="@style/Theme.StackBoxes.Starting"/>

        <!-- One launcher entry per app icon; AppIconChooser keeps exactly one enabled. -->
        <activity-alias
                android:name=".ArcadeIcon"
                android:targetActivity=".MainActivity"
                android:enabled="true"
                android:exported="true"
                android:icon="@mipmap/ic_launcher_arcade"
                android:roundIcon="@mipmap/ic_launcher_arcade"
                android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
                android:name=".SequenceIcon"
                android:targetActivity=".MainActivity"
                android:enabled="false"
                android:exported="true"
                android:icon="@mipmap/ic_launcher_sequence"
                android:roundIcon="@mipmap/ic_launcher_sequence"
                android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
    </application>

</manifest>